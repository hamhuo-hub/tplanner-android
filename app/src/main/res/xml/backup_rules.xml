<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- tplanner_v5.xml is deliberately kept: it is the canonical document store and holds
         offline edits that have not reached the server yet.
         Transport-only state is rebuilt against the restored store and the current server. -->
    <exclude domain="sharedpref" path="tplanner_v5_settings.xml" />
    <exclude domain="sharedpref" path="tplanner_v5_log.xml" />
    <exclude domain="sharedpref" path="tplanner_v5_journal_tokens.xml" />
    <exclude domain="sharedpref" path="tplanner_watch_v5_delivery.xml" />
</full-backup-content>
