<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Activity windows only: the watch-face services retain their artwork and ambient palettes. -->
    <style name="Base.Theme.TPlanner.Wear.Light" parent="android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/tp_light_canvas</item>
        <item name="android:colorBackground">@color/tp_light_canvas</item>
        <item name="android:colorForeground">@color/tp_light_text_primary</item>
        <item name="android:textColorPrimary">@color/tp_light_text_primary</item>
        <item name="android:textColorSecondary">@color/tp_light_text_secondary</item>
        <item name="android:textColorHint">@color/tp_light_text_muted</item>
        <item name="android:colorAccent">@color/tp_light_accent_text</item>
        <item name="android:colorControlNormal">@color/tp_light_border_control</item>
        <item name="android:colorControlActivated">@color/tp_light_accent_text</item>
        <item name="android:colorControlHighlight">@color/tp_light_selected_background</item>
        <item name="android:colorButtonNormal">@color/tp_light_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/tp_light_canvas</item>
        <item name="android:navigationBarColor">@color/tp_light_canvas</item>
        <item name="android:alertDialogTheme">@style/Theme.TPlanner.Wear.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/Theme.TPlanner.Wear.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/Theme.TPlanner.Wear.Dialog</item>
    </style>
    <style name="Base.Theme.TPlanner.Wear.Dialog" parent="android:style/Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:windowBackground">@color/tp_light_raised</item>
        <item name="android:colorBackground">@color/tp_light_raised</item>
        <item name="android:textColorPrimary">@color/tp_light_text_primary</item>
        <item name="android:textColorSecondary">@color/tp_light_text_secondary</item>
        <item name="android:colorAccent">@color/tp_light_accent_text</item>
        <item name="android:colorControlActivated">@color/tp_light_accent_text</item>
        <item name="android:colorButtonNormal">@color/tp_light_surface</item>
    </style>
    <style name="Theme.TPlanner.Wear.Light" parent="Base.Theme.TPlanner.Wear.Light" />
    <style name="Theme.TPlanner.Wear.Dialog" parent="Base.Theme.TPlanner.Wear.Dialog" />
</resources>
