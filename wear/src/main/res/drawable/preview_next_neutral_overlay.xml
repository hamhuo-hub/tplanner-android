        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M0,0 L466,0 L466,466 Z M154,198 H247 V263 H154 Z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M112,263 H286 V296 H112 Z" />

    <!-- Restore the upper-right frame and the three task tracks. -->
